// tsconfig.build.example.json — mẫu tsconfig.build cho project kiểu NestJS.
// Thiếu file này, "nest build" rơi về tsconfig.json (không loại test/) → output "dist"
// LỆCH giữa máy này/máy khác (dist/main.js vs dist/src/main.js) → deploy lên server
// crash boot "Cannot find module '/app/dist/src/main.js'" dù local chạy ngon.
// Đặt ở gốc repo, cùng cấp tsconfig.json. Sửa "start:prod": "node dist/main.js".
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist"
  },
  "exclude": ["node_modules", "test", "dist", "**/*.spec.ts", "**/*.test.ts"]
}
